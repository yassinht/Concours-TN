{
  "name": "concours-tn",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "build:shared": "pnpm --filter @ctn/shared build",
    "dev:api": "pnpm --filter @ctn/api dev",
    "dev:web": "pnpm --filter @ctn/web dev",
    "db:generate": "pnpm --filter @ctn/api db:generate",
    "db:migrate": "pnpm --filter @ctn/api db:migrate",
    "db:seed": "pnpm --filter @ctn/api db:seed",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @ctn/e2e test"
  }
}
