# ── API (apps/api) ──
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/concours_tn
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
JWT_SECRET=change-me-to-a-long-random-string-32+
COOKIE_SECURE=false
# Serve AI-reviewed (not yet human-reviewed) questions with a "beta" badge. Set to false in production once reviewed.
CONTENT_BETA_MODE=true
ADMIN_EMAIL=admin@concours.tn
ADMIN_PASSWORD=admin12345
# AI (optional — deterministic fallbacks are used when unset)
ANTHROPIC_API_KEY=
AI_MODEL_TUTOR=claude-haiku-4-5-20251001
AI_MODEL_CONTENT=claude-sonnet-5-5
# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email (optional — without SMTP_HOST emails are stored in email_outbox with status LOGGED)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Concours TN <no-reply@concours.tn>"
# Web push (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@concours.tn
# Payments
PAYMENTS_MOCK_ENABLED=true
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=
FLOUCI_API_URL=https://developers.flouci.com/api
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
MANUAL_PAYMENT_D17_NUMBER=
MANUAL_PAYMENT_RIB=
UPLOAD_DIR=uploads
CRON_ENABLED=true

# ── Web (apps/web) ──
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
